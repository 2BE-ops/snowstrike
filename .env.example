# SnowStrike — example environment configuration
# Copy to .env and fill in the keys you have. All fields are optional;
# only the LLM provider key for your chosen model backend is required.

# ── LLM providers (at least one required) ──────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# ── Optional: Claude Code CLI as a model backend ───────────────────────────
# CLAUDE_CODE_BINARY=claude
# CLAUDE_CODE_TIMEOUT=900
# CLAUDE_CODE_MAX_BUDGET=

# ── OSINT / enrichment tool API keys (optional) ────────────────────────────
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
SPIDERFOOT_API_KEY=
VIRUSTOTAL_API_KEY=

# ── Model role overrides (optional) ────────────────────────────────────────
# SNOWSTRIKE_ORCHESTRATOR_MODEL=
# SNOWSTRIKE_PLANNING_MODEL=
# SNOWSTRIKE_TOOL_CALLING_MODEL=
# SNOWSTRIKE_COMPACTION_MODEL=

# ── Optional services ──────────────────────────────────────────────────────
# GHIDRA_MCP_URL=http://localhost:8089
# SNOWSTRIKE_TOOL_RUNNER_URL=
# TOOL_RUNNER_AUTH_TOKEN=

# Dashboard port (default 8080)
# PORT=8080

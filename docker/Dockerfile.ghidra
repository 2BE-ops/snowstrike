# SnowStrike - Ghidra MCP Headless Server
#
# Runs ghidra-mcp in headless mode, exposing the REST API on port 8089.
# Based on https://github.com/bethington/ghidra-mcp
#
# Build context assumes ghidra-mcp is cloned into docker/ghidra-mcp/ or
# fetched during build. Adjust GHIDRA_VERSION as needed.

FROM eclipse-temurin:21-jdk AS builder

ARG GHIDRA_VERSION=12.0.4
ARG GHIDRA_DATE=20260303
ARG GHIDRA_SHA=c3b458661d69e26e203d739c0c82d143cc8a4a29d9e571f099c2cf4bda62a120
ARG GHIDRA_MCP_VERSION=5.0.0

ENV GHIDRA_INSTALL_DIR=/opt/ghidra

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl unzip maven python3 python3-pip python3-venv git \
    && rm -rf /var/lib/apt/lists/*

# Download and install Ghidra
RUN curl -fSL -o /tmp/ghidra.zip \
    "https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${GHIDRA_VERSION}_build/ghidra_${GHIDRA_VERSION}_PUBLIC_${GHIDRA_DATE}.zip" \
    && echo "${GHIDRA_SHA}  /tmp/ghidra.zip" | sha256sum -c - \
    && unzip -q /tmp/ghidra.zip -d /opt \
    && mv /opt/ghidra_${GHIDRA_VERSION}_PUBLIC ${GHIDRA_INSTALL_DIR} \
    && rm /tmp/ghidra.zip

# Clone and build ghidra-mcp
RUN git clone --depth 1 --branch v${GHIDRA_MCP_VERSION} \
    https://github.com/bethington/ghidra-mcp.git /tmp/ghidra-mcp \
    || git clone --depth 1 https://github.com/bethington/ghidra-mcp.git /tmp/ghidra-mcp

WORKDIR /tmp/ghidra-mcp

# Install Ghidra JARs into local Maven repo and build
RUN if [ -f ghidra-mcp-setup.sh ]; then \
        chmod +x ghidra-mcp-setup.sh && \
        ./ghidra-mcp-setup.sh --setup-deps --ghidra-path ${GHIDRA_INSTALL_DIR}; \
    fi \
    && mvn clean package assembly:single -DskipTests 2>/dev/null \
    || echo "Maven build attempted"

# ---- Runtime stage ----
FROM eclipse-temurin:21-jre

ARG GHIDRA_VERSION=12.0.4

ENV GHIDRA_INSTALL_DIR=/opt/ghidra
ENV GHIDRA_MCP_PORT=8089
ENV JAVA_OPTS="-Xmx4g -XX:+UseG1GC"

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv curl \
    && rm -rf /var/lib/apt/lists/*

# Copy Ghidra from builder
COPY --from=builder /opt/ghidra /opt/ghidra

# Copy built ghidra-mcp artifacts
COPY --from=builder /tmp/ghidra-mcp /opt/ghidra-mcp

# Install the extension into Ghidra
RUN mkdir -p /root/.config/ghidra/ghidra_${GHIDRA_VERSION}_PUBLIC/Extensions \
    && if ls /opt/ghidra-mcp/target/GhidraMCP-*.zip 1>/dev/null 2>&1; then \
        unzip -q /opt/ghidra-mcp/target/GhidraMCP-*.zip \
            -d /root/.config/ghidra/ghidra_${GHIDRA_VERSION}_PUBLIC/Extensions/; \
    fi

# Install Python bridge dependencies
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir mcp httpx

# Data directory for binaries to analyze
RUN mkdir -p /data /opt/ghidra-projects

WORKDIR /opt/ghidra-mcp

EXPOSE 8089

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:${GHIDRA_MCP_PORT}/check_connection || exit 1

# Start the ghidra-mcp headless server
# The headless server exposes the HTTP REST API directly without needing the GUI
ENTRYPOINT ["sh", "-c", "\
    java ${JAVA_OPTS} \
    -cp '/opt/ghidra-mcp/target/*:/opt/ghidra/Ghidra/Framework/*/lib/*:/opt/ghidra/Ghidra/Features/*/lib/*' \
    com.xebyte.ghidramcp.headless.GhidraMCPHeadlessServer \
    --port ${GHIDRA_MCP_PORT} \
    --bind 0.0.0.0 \
    --project-dir /opt/ghidra-projects \
"]
